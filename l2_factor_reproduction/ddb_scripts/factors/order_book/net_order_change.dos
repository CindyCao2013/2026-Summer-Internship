// net_order_change.dos
// 净委买变化率：开盘 30 分钟 (09:30-10:00) 平均变化率
// 前置条件：CH L2 Snapshot 已同步到本地表 dfs://L2_Snapshot_Daily/snapshot
// 表字段建议：Symbol(SYMBOL), ExchTime(TIMESTAMP), TotalBid(LONG), TotalAsk(LONG)
//   或 BidVolumes/AskVolumes(INT[])，脚本内自动求和

def _load_order_snapshot(startDate, endDate, stocks){
    // 若本地库不存在，调用方会得到明确报错
    t = loadTable('dfs://L2_Snapshot_Daily', 'snapshot')
    cols = t.schema().colDefs.name
    if (`TotalBid in cols){
        raw = select Symbol, ExchTime, TotalBid, TotalAsk from t
            where date(ExchTime) >= startDate and date(ExchTime) <= endDate and Symbol in stocks
    }else{
        raw = select Symbol, ExchTime,
                sum(nullFill(BidVolumes, 0)) as TotalBid,
                sum(nullFill(AskVolumes, 0)) as TotalAsk
            from t
            where date(ExchTime) >= startDate and date(ExchTime) <= endDate and Symbol in stocks
    }
    return raw
}

def _minute_net_order_change(raw){
    t = select Symbol, date(ExchTime) as Date, minute(ExchTime) as Bartime,
            last(TotalBid) as Bid, last(TotalAsk) as Ask
        from raw
        context by Symbol, date(ExchTime), minute(ExchTime)
    t = select *, Bid - Ask as NetOrder from t
    t = select Symbol, Date, Bartime, ratios(NetOrder) - 1 as ChangeRate
        from t context by Symbol, Date csort Bartime
    return t
}

def compute_net_order_change(startDate, endDate, universe='000852.SH'){
    stocks = get_stock_pool(startDate, endDate, universe, true)
    raw = _load_order_snapshot(startDate, endDate, stocks)
    t = _minute_net_order_change(raw)
    t = select Symbol, Date, avg(ChangeRate) as value
        from t
        where Bartime between 09:30m : 10:00m
        group by Symbol, Date
    result = select Symbol as symbol,
            to_signal_tradetime(Date) as tradetime,
            "net_order_change" as factorname,
            value
        from t
        where isValid(value)
    return result
}
