# Secrets — never commit credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# GitHub rejects files >= 100MB; these panels/caches are multi-GB
*.parquet
*.pkl
*.pickle
*.feather
*.h5
*.hdf5
*.duckdb

# Local caches and temp extracts
.tmp_*/
research/cache/
research/results/
result/
sideprojects/**/results/
logs/
*.log
